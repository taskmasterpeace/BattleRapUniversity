# Battle Rap University - Environment Variables Example
# Copy this to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LLM Integration (Open Web UI)
# Set to 'true' to use real LLMs, 'false' to use mock article generation
USE_REAL_LLM=false

# Open Web UI Configuration
OPENWEBUI_BASE_URL=http://localhost:8080
OPENWEBUI_API_KEY=your_openwebui_api_key

# LLM Settings
LLM_TIMEOUT_MS=30000
LLM_RETRIES=3

# Blogger Model Mappings
# Assign different models to different blogger personalities
# Examples: claude-opus, claude-sonnet-3.5, mixtral-8x7b, gpt-4, llama3.1:70b, llama3.1:8b

# Battle Eyez - Investigative drama journalist
BLOGGER_BATTLE_EYEZ_MODEL=claude-opus

# Marijuana Piranha - Raw street perspective
BLOGGER_MARIJUANA_PIRANHA_MODEL=mixtral-8x7b

# Algorithm Institute - Historical analyst
BLOGGER_ALGORITHM_INSTITUTE_MODEL=gpt-4

# The Purist - Technical pen game critic
BLOGGER_THE_PURIST_MODEL=claude-sonnet-3.5

# Hype Man - Enthusiastic fan voice
BLOGGER_HYPE_MAN_MODEL=llama3.1:70b

# Balanced Veteran - Fair professional analyst
BLOGGER_BALANCED_VETERAN_MODEL=claude-sonnet-3.5

# Pissed Poet - Cynical underdog champion
BLOGGER_PISSED_POET_MODEL=mixtral-8x7b

# Elite Snob - Dismissive top-tier critic
BLOGGER_ELITE_SNOB_MODEL=gpt-4
